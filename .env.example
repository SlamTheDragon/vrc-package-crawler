# =============================================================================
# VRC Package Crawler - Environment Configuration
# Copy this file to .env (next to your binary in dist/) and fill in values.
# dist/.env is the canonical location when running compiled binaries.
# .env at the project root is used for development (bun run start).
# =============================================================================

# ------------------------------------------------------------------------------
# GitHub API Token (strongly recommended)
# Without a token: 60 requests/hour. With a token: 5,000 requests/hour.
# Create one at: https://github.com/settings/tokens (no scopes required for public repos)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Cloudflare Edge Sync (optional - only required to run vrc-sync)
# Used by dist/vrc-sync.exe to push incremental catalog deltas to Cloudflare D1
# and upload proxied WebP thumbnails to Cloudflare R2.
#
# Get these from: https://dash.cloudflare.com/profile/api-tokens
# D1 database and R2 bucket must be provisioned first.
# See docs/EDGE_SYNC_AND_SCALE_GUIDE.md for full setup instructions.
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Path Overrides (optional - defaults resolve next to the binary)
# Use these to redirect data files to a different volume or directory.
# Leave blank to use defaults (recommended).
# ------------------------------------------------------------------------------

# Override the SQLite database path
# Default (compiled): <dir of binary>/crawler_state.db
# Default (dev):      <project root>/crawler_state.db
# CRAWLER_DB_PATH=

# Override the logs directory
# Default (compiled): <dir of binary>/logs/
# Default (dev):      <project root>/logs/
# CRAWLER_LOGS_DIR=

# ------------------------------------------------------------------------------
# IPC Control Port (optional - change only if 8765 conflicts)
# The daemon listens on this localhost port for graceful shutdown signals
# from vrc-monitor.exe or the CLI.
# ------------------------------------------------------------------------------
# CRAWLER_IPC_PORT=8765
