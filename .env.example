# ==============================================================================
# VRChat Package Crawler Environment Configuration Template
# Precedence: LEGAL.md > TODO.md > Operational Docs > Implementation
# ==============================================================================

# Server Gateway Configuration (vrc-server)
PORT=8080
HOST=127.0.0.1
CRAWLER_IPC_PORT=8765

# Security & Administrative Authentication
# API_SECRET_TOKEN is the master administrative bearer authentication token
# Guarding mutating and administrative endpoints on vrc-server (POST /v1/reports, POST /v1/telemetry)
# Required Authorization header: "Authorization: Bearer <API_SECRET_TOKEN>"
# Generate with CSPRNG: openssl rand -hex 32
API_SECRET_TOKEN=change_me_to_a_secure_token

# Crawler Politeness & Upstream API Credentials
# Optional GitHub Personal Access Token to raise search quota from 60 to 5,000 req/hr
GITHUB_TOKEN=

# Edge Synchronization Configuration (Cloudflare D1 & R2)
# Required only when running edge sync (vrc-sync or IPC /sync)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=
