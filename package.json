{
  "name": "vrc-package-crawler",
  "version": "1.0.0",
  "description": "High-saturation uncataloged VRChat tools & VPM crawler",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "monitor": "bun run src/tools/status.ts",
    "sync": "bun run src/tools/sync.ts",
    "export": "bun run src/tools/exporter.ts",
    "server": "bun run src/tools/server.ts",
    "steering": "bun run src/tools/steering.ts",
    "sanitize": "bun run src/tools/pipeline_sanitize.ts",
    "discover:vpm": "bun run src/tools/discover_vpm.ts",
    "build:crawler": "bun build --compile --outfile=dist/vrc-crawler.exe src/index.ts",
    "build:monitor": "bun build --compile --outfile=dist/vrc-monitor.exe src/tools/status.ts",
    "build:sync": "bun build --compile --outfile=dist/vrc-sync.exe src/tools/sync.ts",
    "build:server": "bun build --compile --outfile=dist/vrc-server.exe src/tools/server.ts",
    "build:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/vrc-crawler-linux src/index.ts",
    "build:all": "bun run build:crawler && bun run build:monitor && bun run build:sync && bun run build:server && bun run build:linux",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
