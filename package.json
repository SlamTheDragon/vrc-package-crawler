{
  "dependencies": {
    "@types/node": "^26.6.4"
  },
  "scripts": {
    "install": "bun i && bun run install:crawler && bun run install:crawler-client && bun run install:package && bun run install:web && bun run install:worker",
    "install:crawler": "cd src-crawler && bun i",
    "install:crawler-client": "cd src-crawler-client && bun i",
    "install:package": "cd src-package && bun i",
    "install:web": "cd src-web && bun i",
    "install:worker": "cd src-worker && bun i",
    "clean": "echo \"clean builds, caches, and temp files script\n\" && bun run clean:crawler && bun run clean:crawler-client && bun run clean:package && bun run clean:web && bun run clean:worker",
    "clean:crawler": "cd src-crawler && echo \"specify clean targets\"",
    "clean:crawler-client": "cd src-crawler-client && echo \"specify clean targets\"",
    "clean:package": "cd src-package && echo \"specify clean targets\"",
    "clean:web": "cd src-web && echo \"specify clean targets\"",
    "clean:worker": "cd src-worker && echo \"specify clean targets\"",
    "reset": "echo \"purge node modules\n\" && bun run reset:crawler && bun run reset:crawler-client && bun run reset:package && bun run reset:web && bun run reset:worker",
    "reset:crawler": "cd src-crawler && rm -rf node_modules",
    "reset:crawler-client": "cd src-crawler-client && rm -rf node_modules",
    "reset:package": "cd src-package && rm -rf node_modules",
    "reset:web": "cd src-web && rm -rf node_modules",
    "reset:worker": "cd src-worker && rm -rf node_modules",
    "preview": "echo \"bump config.preview.versions.json and create a tagged beta/preview published binaries on all sources\n\" && bun run preview:crawler && bun run preview:crawler-client && bun run preview:package && bun run preview:web && bun run preview:worker",
    "preview:crawler": "cd src-crawler && echo \"specify build scripts\"",
    "preview:crawler-client": "cd src-crawler-client && echo \"specify build scripts\"",
    "preview:package": "cd src-package && echo \"specify build scripts\"",
    "preview:web": "cd src-web && echo \"specify build scripts\"",
    "preview:worker": "cd src-worker && echo \"specify build scripts\"",
    "publish": "echo \"bump config.versions.json and create a tagged beta/preview published binaries on all sources\n\" && bun run publish:crawler && bun run publish:crawler-client && bun run publish:package && bun run publish:web && bun run publish:worker",
    "publish:crawler": "cd src-crawler && echo \"specify build scripts\"",
    "publish:crawler-client": "cd src-crawler-client && echo \"specify build scripts\"",
    "publish:package": "cd src-package && echo \"specify build scripts\"",
    "publish:web": "cd src-web && echo \"specify build scripts\"",
    "publish:worker": "cd src-worker && echo \"specify build scripts\"",
    "bump:crawler": "cd src-crawler && echo \"specify bump criteria\"",
    "bump:crawler-client": "cd src-crawler-client && echo \"specify bump criteria\"",
    "bump:package": "cd src-package && echo \"specify bump criteria\"",
    "bump:web": "cd src-web && echo \"specify bump criteria\"",
    "bump:worker": "cd src-worker && echo \"specify bump criteria\"",
    "bump-preview:crawler": "cd src-crawler && echo \"specify bump criteria\"",
    "bump-preview:crawler-client": "cd src-crawler-client && echo \"specify bump criteria\"",
    "bump-preview:package": "cd src-package && echo \"specify bump criteria\"",
    "bump-preview:web": "cd src-web && echo \"specify bump criteria\"",
    "bump-preview:worker": "cd src-worker && echo \"specify bump criteria\""
  },
  "name": "vrc-package-crawler",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
