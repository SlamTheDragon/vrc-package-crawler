{
  "name": "vrc-package-crawler",
  "version": "1.0.0",
  "description": "High-saturation uncataloged VRChat tools & VPM crawler",
  "license": "AGPL-3.0-or-later",
  "module": "src/crawler/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/crawler/index.ts",
    "coordinator": "bun run src/worker/local_main.ts",
    "node": "bun run src/node/main.ts",
    "monitor": "bun run src/monitor/index.ts",
    "sync": "bun run src/sync/index.ts",
    "export": "bun run src/sync/exporter.ts",
    "server": "bun run src/server/index.ts",
    "project": "bun run src/crawler/projection.ts",
    "build:crawler": "bun build --compile --outfile=dist/vrc-crawler.exe src/crawler/index.ts",
    "build:node": "bun build --compile --outfile=dist/vrc-node.exe src/node/main.ts",
    "build:node:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/vrc-node-linux src/node/main.ts",
    "build:coordinator": "bun build --compile --outfile=dist/vrc-coordinator.exe src/worker/local_main.ts",
    "build:coordinator:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/vrc-coordinator-linux src/worker/local_main.ts",
    "build:worker": "bun build --target=browser --outdir=dist/worker src/worker/handler.ts src/worker/operator_handler.ts",
    "build:monitor": "bun build --compile --outfile=dist/vrc-monitor.exe src/monitor/index.ts",
    "build:sync": "bun build --compile --outfile=dist/vrc-sync.exe src/sync/index.ts",
    "build:server": "bun build --compile --outfile=dist/vrc-server.exe src/server/index.ts",
    "build:server:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/vrc-server-linux src/server/index.ts",
    "build:export": "bun build --compile --outfile=dist/vrc-export.exe src/sync/exporter.ts",
    "build:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/vrc-crawler-linux src/crawler/index.ts",
    "build:all": "bun run build:crawler && bun run build:node && bun run build:node:linux && bun run build:coordinator && bun run build:coordinator:linux && bun run build:worker && bun run build:monitor && bun run build:sync && bun run build:server && bun run build:server:linux && bun run build:linux && bun run build:export",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:docs": "bun run scratch/check_doc_links.ts",
    "smoke:local": "bun run scratch/smoke_local.ts",
    "smoke:multi": "bun run scratch/smoke_multi_coordinator.ts",
    "smoke:vpm:live": "bun run scratch/smoke_live_vpm.ts",
    "smoke:github:live": "bun run scratch/smoke_live_github.ts"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@trybyte/robotstxt-parser": "2.0.0",
    "cheerio": "^1.2.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  }
}
