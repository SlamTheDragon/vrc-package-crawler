{
  "name": "vrc-package-crawler",
  "version": "1.0.0",
  "description": "VRChat Package Crawler - Yet Another Discovery Tool that crawls the public VRChat Web Ecosystem for VCC, Tooling, Assets, World Creation, Avatars & many more. Not affiliated with VRChat Inc.",
  "license": "AGPL-3.0-or-later",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "coordinator": "bun run src/worker/main.ts",
    "node": "bun run src/node/main.ts",
    "build": "bun run build:node && bun run build:coordinator && bun run build:worker",
    "build:node": "bun build --compile --outfile=dist/local-node/vrc-node.exe src/node/main.ts",
    "build:worker": "bun build --target=browser --outdir=dist/worker src/worker/handler.ts src/worker/operator_handler.ts",
    "build:coordinator": "bun build --compile --outfile=dist/local-coordinator/vrc-coordinator.exe src/worker/main.ts",
    "build:linux": "bun run build:node:linux && bun run build:coordinator:linux",
    "build:node:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/local-node/vrc-node-linux src/node/main.ts",
    "build:coordinator:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/local-coordinator/vrc-coordinator-linux src/worker/main.ts",
    "test": "bun test",
    "check:docs": "bun run ../.agents/scripts/check_doc_links.ts",
    "smoke:local": "bun run scratch/smoke_local.ts",
    "smoke:multi": "bun run scratch/smoke_multi_coordinator.ts",
    "smoke:vpm:live": "bun run scratch/smoke_live_vpm.ts",
    "smoke:github:live": "bun run scratch/smoke_live_github.ts",
    "smoke:preprod": "bun run scratch/smoke_preprod_simulation.ts",
    "smoke:continuous": "bun run scratch/smoke_preprod_continuous.ts"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@trybyte/robotstxt-parser": "2.0.0",
    "@types/node": "^26.6.3",
    "cheerio": "^1.2.0",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  }
}