{
  "name": "vrc-package-crawler",
  "version": "1.0.0",
  "description": "VRChat Package Crawler - Yet Another Discovery Tool that crawls the public VRChat Web Ecosystem for VCC, Tooling, Assets, World Creation, Avatars & many more. Not affiliated with VRChat Inc.",
  "license": "AGPL-3.0-or-later",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "node": "bun run src/main.ts",
    "build": "bun run build:node",
    "build:node": "bun build --compile --outfile=dist/local-node/vrc-node.exe src/main.ts",
    "build:linux": "bun run build:node:linux",
    "build:node:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/local-node/vrc-node-linux src/main.ts",
    "test": "bun test",
    "check:docs": "bun run ../.agents/scripts/check_doc_links.ts"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@trybyte/robotstxt-parser": "2.0.0",
    "@types/node": "^26.6.3",
    "cheerio": "^1.2.0",
    "semver": "^7.8.5",
    "vrc-packages-api": "file:../src-package",
    "zod": "^4.6.5"
  }
}
