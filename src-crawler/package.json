{
  "name": "vrcp-crawler-node",
  "version": "0.0.11",
  "description": "Headless crawler node for VRC Packages (VRCP). Fetches coordinator-leased public metadata. Not affiliated with VRChat Inc.",
  "license": "AGPL-3.0-or-later",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "delivery:preview": "bun run --cwd .. delivery:preview crawler",
    "delivery:release": "bun run --cwd .. delivery:release crawler",
    "prepare:dev": "bun run --cwd .. prepare:dev preview crawler",
    "typecheck": "tsc --noEmit",
    "node": "bun run src/main.ts",
    "build": "bun run build:dev",
    "build:dev": "bun build --compile --outfile=dist/dev/vrcp-crawler-node.exe src/main.ts",
    "build:node": "bun run build:dev",
    "build:linux": "bun run build:node:linux",
    "build:node:linux": "bun build --compile --target=bun-linux-x64 --outfile=dist/dev/vrcp-crawler-node-linux src/main.ts",
    "build:node:musl": "bun build --compile --target=bun-linux-x64-musl --outfile=dist/dev/vrcp-crawler-node-linux src/main.ts",
    "test": "bun test",
    "check:docs": "bun run ../.agents/scripts/check_doc_links.ts"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@trybyte/robotstxt-parser": "2.0.0",
    "@types/node": "^26.6.3",
    "cheerio": "^1.2.0",
    "semver": "^7.8.5",
    "vrc-packages-api": "npm:vrc-packages-api-preview@latest",
    "vrc-packages-network": "https://github.com/SlamTheDragon/vrc-packages/releases/download/vrcp-network/v2026.10.6/vrc-packages-network-2026.10.6.tgz",
    "zod": "^4.6.5"
  },
  "packageManager": "bun@1.4.2"
}
