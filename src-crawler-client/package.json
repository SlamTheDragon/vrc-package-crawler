{
  "name": "vrcp-crawler-client",
  "version": "0.0.0",
  "description": "Desktop crawler-client shell for VRC Packages (VRCP).",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "build": "tauri build",
    "build:dev": "tauri build --debug --no-bundle",
    "build:web": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vrc-packages-api": "0.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "cn": "^0.3.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
