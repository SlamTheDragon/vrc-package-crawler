{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCP Crawler Client",
  "version": "../package.json",
  "identifier": "com.vrcpackages.crawlerclient",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VRCP Crawler Client",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "26.10.3"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
