{
  "name": "vrc-packages-api",
  "version": "0.1.0",
  "description": "TypeScript SDK, schemas, and taxonomy for the VRChat Package Crawler ecosystem",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./types": "./src/types/index.ts",
    "./taxonomy": "./src/taxonomy/index.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "typescript": "^7.0.2"
  }
}
