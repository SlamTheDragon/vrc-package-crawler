{
	"name": "vrcp-worker",
	"version": "2026.10.9-pre",
	"private": true,
	"type": "module",
	"scripts": {
		"delivery:preview": "bun run --cwd .. delivery:preview worker",
		"delivery:release": "bun run --cwd .. delivery:release worker",
		"preview:init": "bun run --cwd .. worker:preview:init",
		"prepare:dev": "bun run --cwd .. prepare:dev preview worker",
		"build": "bun run build:preview",
		"build:preview": "wrangler deploy --dry-run --autoconfig=false --env preview --outdir .wrangler/dev-build/preview --config wrangler.toml",
		"build:release": "wrangler deploy --dry-run --autoconfig=false --env=\"\" --outdir .wrangler/dev-build/production --config wrangler.toml",
		"check": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"deploy": "bun run --cwd .. deploy:release:worker",
		"deploy:preview": "bun run --cwd .. deploy:preview:worker",
		"deploy:release": "bun run --cwd .. deploy:release:worker",
		"dev": "wrangler dev --env preview --config wrangler.toml --persist-to .wrangler/local-preview",
		"start": "bun run dev",
		"test": "bun test ./test",
		"test:workers": "vitest run",
		"test:runtime": "node test/coordinator_runtime_smoke.mjs",
		"cf-typegen": "wrangler types --config wrangler.toml"
	},
	"dependencies": {
		"@trybyte/robotstxt-parser": "2.0.0",
		"vrc-packages-api": "npm:vrc-packages-api-preview@latest",
		"vrc-packages-network": "https://github.com/SlamTheDragon/vrc-packages/releases/download/vrcp-network/v2026.10.6/vrc-packages-network-2026.10.6.tgz",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"miniflare": "5.20261001.0-alpha",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "4.147.0"
	},
	"packageManager": "bun@1.4.2"
}
